# PostgreSQL database name used by the database and backend containers.
POSTGRES_DB=mts_db
# PostgreSQL application user; replace for a public deployment.
POSTGRES_USER=mts_app
# PostgreSQL password; generate one with: openssl rand -base64 48
POSTGRES_PASSWORD=REPLACE_WITH_A_UNIQUE_RANDOM_DATABASE_PASSWORD

# JWT signing secret (at least 32 characters); generate one with: openssl rand -base64 48
JWT_SECRET=REPLACE_WITH_A_UNIQUE_RANDOM_JWT_SECRET
# Admin account password; use a unique password of at least 12 characters.
# Required only for the first setup or when ADMIN_PASSWORD_RESET=true; it can be
# removed after the first admin has been created.
ADMIN_PASSWORD=REPLACE_WITH_A_UNIQUE_ADMIN_PASSWORD
# Emergency only: set true for one backend startup to reset the existing admin password
# to ADMIN_PASSWORD and revoke its active refresh tokens. Set back to false immediately after use.
ADMIN_PASSWORD_RESET=false
# Set true only when you intentionally want the public demo Operator account enabled.
DEMO_USER_ENABLED=false
# Demo business data defaults to true in Development and false in Production.
# Set true only for a sanitized demo deployment; the guarded reset script also requires this flag.
DEMO_DATA_ENABLED=

# Label OCR is optional and off by default (the public demo runs without it). To enable it, set
# OCR_ENABLED=true and start the local PaddleOCR container: docker compose --profile ocr up -d --build
# No external provider or API key is required. While disabled, label scanning returns HTTP 503.
OCR_ENABLED=false
OCR_MODE=Remote
OCR_ENDPOINT=http://ocr-service:8080/ocr
# Optional fixture override when OCR_MODE=Sample in a non-Production environment.
OCR_SAMPLE_TEXT=

# Comma-separated browser origins allowed to call the API; use exact origins (scheme + host, no trailing slash).
ALLOWED_ORIGINS=https://your-domain.example
# Public DNS name used by Caddy to obtain and renew HTTPS certificates.
DOMAIN=your-domain.example

# Optional SMTP relay. Leave blank when no SMTP relay is configured (including the live deployment).
SMTP_HOST=
# SMTP server port; Mailpit uses 1025.
SMTP_PORT=1025
# Optional frontend API path. Keep /api behind Caddy.
VITE_API_URL=/api
# Optional Vite development API target when running frontend and backend outside Compose.
VITE_DEV_API_TARGET=http://localhost:5059
# Login IP rate limit can be overridden with these ASP.NET Core configuration keys.
# RateLimiting__Login__PermitLimit=10
# RateLimiting__Login__WindowSeconds=60
# Safety Assistant IP limit can be overridden independently.
# RateLimiting__SafetyAssistant__PermitLimit=10
# RateLimiting__SafetyAssistant__WindowSeconds=60
# Admin Excel bulk import (/api/chemicals/bulk-import) IP limit; defaults to 5 requests per 60 seconds.
# RateLimiting__ExcelImport__PermitLimit=5
# RateLimiting__ExcelImport__WindowSeconds=60
# Expired refresh tokens are deleted after RetentionDays; revoked but unexpired tokens are kept for audit and investigation.
# The first cleanup runs about one minute after startup, then every IntervalHours.
RefreshTokenCleanup__IntervalHours=6
RefreshTokenCleanup__RetentionDays=1
