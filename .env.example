# PostgreSQL database name used by the database and backend containers.
POSTGRES_DB=mts_db
# PostgreSQL application user; replace for a public deployment.
POSTGRES_USER=mts_app
# PostgreSQL password; generate one with: openssl rand -base64 48
POSTGRES_PASSWORD=REPLACE_WITH_A_UNIQUE_RANDOM_DATABASE_PASSWORD

# JWT signing secret (at least 32 characters); generate one with: openssl rand -base64 48
JWT_SECRET=REPLACE_WITH_A_UNIQUE_RANDOM_JWT_SECRET
# Admin account password; use a unique password of at least 12 characters.
ADMIN_PASSWORD=REPLACE_WITH_A_UNIQUE_ADMIN_PASSWORD
# Set true only when you intentionally want the public demo Operator account enabled.
DEMO_USER_ENABLED=false

# Comma-separated browser origins allowed to call the API; DuckDNS subdomains may use https://*.duckdns.org.
ALLOWED_ORIGINS=https://your-name.duckdns.org
# Public DNS name used by Caddy to obtain and renew HTTPS certificates.
DOMAIN=your-name.duckdns.org

# Optional SMTP relay. Leave blank when no SMTP relay is configured (including the live deployment).
SMTP_HOST=
# SMTP server port; Mailpit uses 1025.
SMTP_PORT=1025
# Optional frontend API path. Keep /api behind Caddy.
VITE_API_URL=/api
# Optional Vite development API target when running frontend and backend outside Compose.
VITE_DEV_API_TARGET=http://localhost:5059
# Login IP rate limit can be overridden with these ASP.NET Core configuration keys.
# RateLimiting__Login__PermitLimit=10
# RateLimiting__Login__WindowSeconds=60
# Safety Assistant IP limit can be overridden independently.
# RateLimiting__SafetyAssistant__PermitLimit=10
# RateLimiting__SafetyAssistant__WindowSeconds=60
